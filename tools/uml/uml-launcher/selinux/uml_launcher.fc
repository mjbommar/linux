##
## File-context rules for uml-launcher.
##
## Paths: the upstream install paths match the `@{exec_path}`
## list in the AppArmor profile (/usr/bin and /usr/local/bin).
## /run/uml-launcher covers the mconsole + backend sockets.
## Packagers installing elsewhere should either symlink under
## one of the covered paths or ship a site-local .fc addendum
## with the alternative path.

/usr/bin/uml-launcher           --      gen_context(system_u:object_r:uml_launcher_exec_t,s0)
/usr/local/bin/uml-launcher     --      gen_context(system_u:object_r:uml_launcher_exec_t,s0)
/run/uml-launcher(/.*)?                 gen_context(system_u:object_r:uml_launcher_runtime_t,s0)
