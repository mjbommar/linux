schema_version = 1
volumes = []

[instance]
name = "soak-kbuild-{{BACKEND}}-w0"

[kernel]
path = "{{KERNEL}}"
backend = "{{BACKEND}}"

[runtime]
mem = "1G"
ncpus = 4

[network]
mode = "none"

[env]
TMPDIR = "/tmp"
KBUILD_OUTPUT = "/tmp/build"

[[init.phases]]
name = "smoke"
cmd = "/bin/true && echo SMOKE_OK"
expect = ""
timeout_secs = 0

# tinyconfig build of UML kernel (host = guest arch). Uses /tmp tmpfs
# for KBUILD_OUTPUT to avoid hostfs write fan-out. Tests fork-storm
# (gcc invocations), pipe (make jobserver), file I/O at high rate.
#
# Each command uses `&& echo OK || (echo FAIL; exit 1)` instead of
# pipe-with-tail to avoid the pipefail-loss bug: `cmd | tail; echo rc=$?` makes
# $? = tail's exit (always 0), masking the build failure and producing
# false PASS verdicts.
[[init.phases]]
name = "tinyconfig"
cmd = "mkdir -p /tmp/build && cd /home/mjbommar/projects/personal/linux && make ARCH=um O=/tmp/build tinyconfig >/tmp/tc.log 2>&1 && echo TINYCONFIG_OK || (tail -10 /tmp/tc.log; echo TINYCONFIG_FAIL; exit 1)"
expect = ""
timeout_secs = 60

[[init.phases]]
name = "kbuild"
cmd = "cd /home/mjbommar/projects/personal/linux && make ARCH=um O=/tmp/build -j4 vmlinux >/tmp/kb.log 2>&1 && [ -e /tmp/build/vmlinux ] && echo KBUILD_OK || (tail -20 /tmp/kb.log; echo KBUILD_FAIL; exit 1)"
expect = ""
timeout_secs = 600

[[init.phases]]
name = "report"
cmd = "echo REPRO_DONE rc=0"
expect = ""
timeout_secs = 0

[host_resources]
# Soak defaults: predictable THP, expendable OOM bias.
# Hugepages and cpu_affinity opt in; they require host-side reservation.
# Cgroup limits opt in; they require a writable cgroup hierarchy.
thp = "off"
oom_score_adj = 500
