schema_version = 1
volumes = []

# Tier 3 FastAPI-shaped loopback HTTP server.
#
# This template uses Python stdlib `http.server` as a self-contained
# stand-in for the FastAPI+uvicorn stack. The Django variant uses the
# same stdlib shape; deployments can switch this command to uvicorn
# after installing python3-fastapi and python3-uvicorn.
#
# Host prerequisites:
#   1. Install python3-fastapi python3-uvicorn or use
#      a uv venv: `uv venv ~/.cache/uml-soak-tier3-fastapi-venv;
#      uv pip install --python ... fastapi uvicorn`).
#   2. Rebuild the UML kernel with CONFIG_UML_NET_VECTOR=y.
#   3. To exercise the real FastAPI stack, replace the stdlib server with
#      a real `python3 -m uvicorn app:app --host 0.0.0.0
#      --port 8080` invocation.

[instance]
name = "soak-tier3-fastapi-{{BACKEND}}-w{{WORKER_IDX}}"

[kernel]
path = "{{KERNEL}}"
backend = "{{BACKEND}}"

[runtime]
# 1024M leaves room for framework imports and the kvm-v2 vCPU pool's
# pinned overhead.
mem = "1024M"
ncpus = 2

[network]
mode = "tap"
driver = "{{NETWORK_DRIVER}}"
tap_name = "{{TAP_NAME}}"
guest_ip = "{{GUEST_IP}}"
host_ip = "{{HOST_IP}}"
gateway = "{{HOST_IP_PLAIN}}"
nameservers = []
masquerade_via = "auto"
ports = []

[env]
TMPDIR = "/tmp"
PYTHONHASHSEED = "0"
HOME = "/tmp"

[[init.phases]]
name = "smoke"
cmd = "/bin/true && echo SMOKE_OK"
expect = ""
timeout_secs = 5

# Start the HTTP server in the background.
# The default uses Python stdlib `http.server`; deployments can switch
# this command to uvicorn when testing the full FastAPI stack.
[[init.phases]]
name = "fastapi-up"
cmd = """
cd /tmp && cat > tier3-fastapi-app.py <<'PY'
import http.server, json
class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == '/health':
            body = json.dumps({"ok": True, "framework": "fastapi-shim"}).encode()
            self.send_response(200); self.send_header("Content-Type","application/json"); self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)
        else:
            self.send_error(404)
    def log_message(self, *a, **kw):
        pass
http.server.HTTPServer(('0.0.0.0', 8080), H).serve_forever()
PY
python3 /tmp/tier3-fastapi-app.py >/tmp/fastapi.log 2>&1 &
echo $! > /tmp/fastapi.pid
dump_server_log() {
    echo FASTAPI_LOG_BEGIN
    cat /tmp/fastapi.log 2>/dev/null || true
    echo FASTAPI_LOG_END
}
port_ready() {
python3 - <<'PY'
import socket, sys
s = socket.socket()
s.settimeout(0.2)
try:
    s.connect(("127.0.0.1", 8080))
except OSError:
    sys.exit(1)
finally:
    s.close()
PY
}
for i in $(seq 1 60); do
    port_ready && break
    sleep 0.5
done
port_ready || { dump_server_log; echo SERVER_FAIL; exit 1; }
echo SERVER_READY
"""
expect = "SERVER_READY"
timeout_secs = 45

# In-guest check.
[[init.phases]]
name = "guest-curl"
cmd = """
ok=0; fail=0
for i in $(seq 1 100); do
    code=$(curl -s -o /dev/null -w '%{http_code}' \
        http://127.0.0.1:8080/health)
    if [ "$code" = "200" ]; then ok=$((ok+1));
    else fail=$((fail+1)); fi
done
echo "GUEST_CURL ok=$ok fail=$fail"
[ "$fail" -eq 0 ] && echo TIER3_OK || (echo TIER3_FAIL; exit 1)
"""
expect = ""
timeout_secs = 30

# Shut down the server.
[[init.phases]]
name = "shutdown"
cmd = """
kill $(cat /tmp/fastapi.pid) 2>/dev/null || true
sleep 1
echo REPRO_DONE rc=$?
"""
expect = ""
timeout_secs = 10

[host_resources]
# Soak defaults: predictable THP, expendable OOM bias.
# Hugepages and cpu_affinity opt-in require host-side reservation.
# Cgroup limits opt-in require a writable cgroup hierarchy.
thp = "off"
oom_score_adj = 500
