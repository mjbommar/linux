schema_version = 1
volumes = []

# Phase J Tier 3 — FastAPI (uvicorn) loopback HTTP server.
# Spec: phase-J-tier3-design-2026-05-14.md §7.2 (analogous to
# §7.1 Django; same shape, different framework).
#
# This template uses Python stdlib `http.server` as a stand-in
# for the FastAPI+uvicorn stack until operator pre-flight
# installs python3-fastapi + python3-uvicorn. The Django
# variant uses the same stdlib shim — they share the in-tree
# template body but exercise different operator-time installs.
#
# Operator pre-flight (ONE-TIME, NOT yet done):
#   1. apt-get install python3-fastapi python3-uvicorn (OR use
#      a uv venv: `uv venv ~/.cache/uml-soak-tier3-fastapi-venv;
#      uv pip install --python ... fastapi uvicorn`).
#   2. CONFIG_UML_NET_VECTOR=y rebuild (see tier3-django.toml.
#      template header).
#   3. Replace the `python3 -m http.server` stand-in below with
#      a real `python3 -m uvicorn app:app --host 0.0.0.0
#      --port 8080` invocation.

[instance]
name = "soak-tier3-fastapi-{{BACKEND}}-w{{WORKER_IDX}}"

[kernel]
path = "{{KERNEL}}"
backend = "{{BACKEND}}"

[runtime]
# 1024M headroom — first live smoke of the sibling Django
# template at mem=768M tripped a swapper page allocation
# failure (order:0) during guest boot under the deferred-
# physmem-memslot v2 path. FastAPI/uvicorn has a smaller
# import set than Django but the headroom is the same.
mem = "1024M"
ncpus = 2

[network]
mode = "tap"
driver = "{{NETWORK_DRIVER}}"
tap_name = "{{TAP_NAME}}"
guest_ip = "{{GUEST_IP}}"
host_ip = "{{HOST_IP}}"
gateway = "{{HOST_IP_PLAIN}}"
nameservers = []
masquerade_via = "auto"
ports = []

[env]
TMPDIR = "/tmp"
PYTHONHASHSEED = "0"
HOME = "/home/mjbommar"

[[init.phases]]
name = "smoke"
cmd = "/bin/true && echo SMOKE_OK"
expect = ""
timeout_secs = 5

# Phase 2: bring up the async HTTP server in background.
# Stand-in: Python stdlib `http.server`. Replace with uvicorn
# once operator pre-flight is done.
[[init.phases]]
name = "fastapi-up"
cmd = """
cd /tmp && cat > tier3-fastapi-app.py <<'PY'
import http.server, json
class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == '/health':
            body = json.dumps({"ok": True, "framework": "fastapi-shim"}).encode()
            self.send_response(200); self.send_header("Content-Type","application/json"); self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)
        else:
            self.send_error(404)
    def log_message(self, *a, **kw):
        pass
http.server.HTTPServer(('0.0.0.0', 8080), H).serve_forever()
PY
python3 /tmp/tier3-fastapi-app.py >/tmp/fastapi.log 2>&1 &
echo $! > /tmp/fastapi.pid
dump_server_log() {
    echo FASTAPI_LOG_BEGIN
    cat /tmp/fastapi.log 2>/dev/null || true
    echo FASTAPI_LOG_END
}
dump_kvm_v2_trace() {
    mkdir -p /sys/kernel/debug 2>/dev/null || true
    grep -q ' /sys/kernel/debug ' /proc/mounts 2>/dev/null ||
        mount -t debugfs none /sys/kernel/debug 2>/dev/null || true
    if [ -w /sys/kernel/debug/um_kvm_v2_trace/dump ]; then
        echo KVM_V2_TRACE_DUMP_BEGIN
        echo 1 > /sys/kernel/debug/um_kvm_v2_trace/dump 2>/dev/null || true
        dmesg | grep 'KVMV2T' | tail -n 400 2>/dev/null || true
        echo KVM_V2_TRACE_DUMP_END
    fi
}
port_ready() {
python3 - <<'PY'
import socket, sys
s = socket.socket()
s.settimeout(0.2)
try:
    s.connect(("127.0.0.1", 8080))
except OSError:
    sys.exit(1)
finally:
    s.close()
PY
}
for i in $(seq 1 60); do
    port_ready && break
    sleep 0.5
done
port_ready || { dump_server_log; dump_kvm_v2_trace; echo SERVER_FAIL; exit 1; }
echo SERVER_READY
"""
expect = "SERVER_READY"
timeout_secs = 45

# Phase 3: in-guest self-test.
[[init.phases]]
name = "guest-curl"
cmd = """
ok=0; fail=0
for i in $(seq 1 100); do
    code=$(curl -s -o /dev/null -w '%{http_code}' \
        http://127.0.0.1:8080/health)
    if [ "$code" = "200" ]; then ok=$((ok+1));
    else fail=$((fail+1)); fi
done
echo "GUEST_CURL ok=$ok fail=$fail"
[ "$fail" -eq 0 ] && echo TIER3_OK || (echo TIER3_FAIL; exit 1)
"""
expect = ""
timeout_secs = 30

# Phase 4: shutdown.
[[init.phases]]
name = "shutdown"
cmd = """
kill $(cat /tmp/fastapi.pid) 2>/dev/null || true
sleep 1
echo REPRO_DONE rc=$?
"""
expect = ""
timeout_secs = 10

[host_resources]
# SMP-T78..T84 (memo 52: UML host resource controls).
# Soak defaults: predictable THP, expendable OOM bias.
# Hugepages and cpu_affinity opt-in — require host-side reservation.
# Cgroup limits opt-in — require writable cgroup hierarchy.
thp = "off"
oom_score_adj = 500
