schema_version = 1
volumes = []

# Django-shaped stdlib HTTP loopback control with no UML network device.
#
# This is a KVM-v2/vector2 isolation workload.  It keeps the Tier 3
# Django stdlib server shape, the readiness socket probe, and the
# in-guest curl loop, but uses network.mode = "none".  If this flakes
# under kvm-v2, vector2 TAP/fd setup is not required to reproduce the
# userspace-execution failure.

[instance]
name = "soak-django-loopback-none-{{BACKEND}}-w0"

[kernel]
path = "{{KERNEL}}"
backend = "{{BACKEND}}"
append = ["kvm_v2_trace_enable"]

[runtime]
mem = "1024M"
ncpus = 2

[network]
mode = "none"

[env]
TMPDIR = "/tmp"
PYTHONHASHSEED = "0"
PATH = "/usr/bin:/bin:/sbin:/usr/sbin"

[[init.phases]]
name = "smoke"
cmd = "/bin/true && echo SMOKE_OK"
expect = ""
timeout_secs = 5

[[init.phases]]
name = "django-up"
cmd = """
cd /tmp && cat > tier3-django-loopback-app.py <<'PY'
import http.server, json
class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == '/health':
            body = json.dumps({"ok": True}).encode()
            self.send_response(200); self.send_header("Content-Type","application/json"); self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)
        else:
            self.send_error(404)
    def log_message(self, *a, **kw):
        pass
http.server.HTTPServer(('0.0.0.0', 8080), H).serve_forever()
PY
python3 /tmp/tier3-django-loopback-app.py >/tmp/django-loopback.log 2>&1 &
echo $! > /tmp/django-loopback.pid
dump_server_log() {
    echo DJANGO_LOOPBACK_LOG_BEGIN
    cat /tmp/django-loopback.log 2>/dev/null || true
    echo DJANGO_LOOPBACK_LOG_END
}
dump_kvm_v2_trace() {
    mkdir -p /sys/kernel/debug 2>/dev/null || true
    grep -q ' /sys/kernel/debug ' /proc/mounts 2>/dev/null ||
        mount -t debugfs none /sys/kernel/debug 2>/dev/null || true
    if [ -w /sys/kernel/debug/um_kvm_v2_trace/dump ]; then
        echo KVM_V2_TRACE_DUMP_BEGIN
        echo 1 > /sys/kernel/debug/um_kvm_v2_trace/dump 2>/dev/null || true
        dmesg | grep 'KVMV2T' 2>/dev/null || true
        echo KVM_V2_TRACE_DUMP_END
    fi
}
port_ready() {
python3 - <<'PY'
import socket, sys
s = socket.socket()
s.settimeout(0.2)
try:
    s.connect(("127.0.0.1", 8080))
except OSError:
    sys.exit(1)
finally:
    s.close()
PY
}
for i in $(seq 1 60); do
    port_ready && break
    sleep 0.5
done
port_ready || { dump_server_log; dump_kvm_v2_trace; echo SERVER_FAIL; exit 1; }
echo SERVER_READY
"""
expect = "SERVER_READY"
timeout_secs = 45

[[init.phases]]
name = "guest-curl"
cmd = """
ok=0; fail=0
for i in $(seq 1 100); do
    code=$(curl -s -o /dev/null -w '%{http_code}' \
        http://127.0.0.1:8080/health)
    if [ "$code" = "200" ]; then ok=$((ok+1));
    else fail=$((fail+1)); fi
done
echo "GUEST_CURL ok=$ok fail=$fail"
[ "$fail" -eq 0 ] && echo TIER3_OK || (echo TIER3_FAIL; exit 1)
"""
expect = ""
timeout_secs = 30

[[init.phases]]
name = "shutdown"
cmd = """
kill $(cat /tmp/django-loopback.pid) 2>/dev/null || true
sleep 1
echo REPRO_DONE rc=$?
"""
expect = ""
timeout_secs = 10

[host_resources]
# SMP-T78..T84 (memo 52: UML host resource controls).
# Soak defaults: predictable THP, expendable OOM bias.
# Hugepages and cpu_affinity opt-in — require host-side reservation.
# Cgroup limits opt-in — require writable cgroup hierarchy.
thp = "off"
oom_score_adj = 500
