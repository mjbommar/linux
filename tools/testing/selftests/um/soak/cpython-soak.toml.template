schema_version = 1
volumes = []

[instance]
name = "soak-cpython-{{BACKEND}}-w0"

[kernel]
path = "{{KERNEL}}"
backend = "{{BACKEND}}"

[runtime]
# CPython 3.14 + a curated stdlib testset peaks at ~600-800 MB resident
# under UML; 512M was historically too tight and produced a guest-side
# "System is deadlocked on memory" panic every iteration (r14-24h-soak
# 2026-05-19 evidence). 1024M leaves ~250 MB headroom for the test
# harness + buddy fragmentation under sustained iteration.
mem = "1024M"
ncpus = 4

[network]
mode = "none"

[env]
TMPDIR = "/tmp"
PYTHONHASHSEED = "0"

[[init.phases]]
name = "smoke"
cmd = "/bin/true && echo SMOKE_OK"
expect = ""
timeout_secs = 0

# Curated subset focused on syscall hot paths kvm-v2 must handle
# correctly. Tight set picked to complete in ~60-90s wall-clock under
# UML overhead. Skips heavyweights (test_subprocess /
# test_concurrent_futures / test_threading would each take >60s under
# UML). Phase succeeds iff regrtest returns 0; explicit `|| (echo
# PYTEST_FAIL; exit 1)` ensures the phase wrapper sees non-zero on
# any failure (avoids the pipefail-loss bug from `cmd | tail; echo
# rc=$?` where echo's 0 masks pipeline failure).
[[init.phases]]
name = "pytest"
# `-x test_process_cpu_count_affinity` skips a kvm-v2-architectural
# failure documented in state-audit/27-sched_setaffinity-EBUSY.md:
# kvm_v2_vcpu_run holds migrate_disable() over dispatch (the SMP-T13
# fix), and Linux returns -EBUSY from sched_setaffinity when
# migrate_disable > 0.  test_os.test_process_cpu_count_affinity
# exercises exactly this contract and therefore deterministically
# fails on kvm-v2 SMP.  The remaining 9 modules exercise syscall hot
# paths that matter for substrate correctness without tripping the
# affinity contract.
cmd = "python3 -m test --timeout 60 -j 2 -x test_process_cpu_count_affinity test_signal test_io test_mmap test_fcntl test_os test_select test_threadsignals test_posix test_fork1 test_random test_hashlib && echo PYTEST_OK || (echo PYTEST_FAIL; exit 1)"
expect = ""
timeout_secs = 240

[[init.phases]]
name = "report"
cmd = "echo REPRO_DONE rc=$?"
expect = ""
timeout_secs = 0

[host_resources]
# SMP-T78..T84 (memo 52: UML host resource controls).
# Soak defaults: predictable THP, expendable OOM bias.
# Hugepages and cpu_affinity opt-in — require host-side reservation.
# Cgroup limits opt-in — require writable cgroup hierarchy.
thp = "off"
oom_score_adj = 500
