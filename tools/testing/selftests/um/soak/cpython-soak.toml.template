schema_version = 1
volumes = []

[instance]
name = "soak-cpython-{{BACKEND}}-w0"

[kernel]
path = "{{KERNEL}}"
backend = "{{BACKEND}}"

[runtime]
# CPython 3.14 + a curated stdlib testset peaks at ~600-800 MB resident
# under UML; 512M was historically too tight and produced a guest-side
# "System is deadlocked on memory" panic every iteration (r14-24h-soak
# 2026-05-19 evidence). 1024M leaves ~250 MB headroom for the test
# harness + buddy fragmentation under sustained iteration.
mem = "1024M"
ncpus = 4

[network]
mode = "none"

[env]
TMPDIR = "/tmp"
PYTHONHASHSEED = "0"

[[init.phases]]
name = "smoke"
cmd = "/bin/true && echo SMOKE_OK"
expect = ""
timeout_secs = 0

# Curated subset focused on syscall hot paths kvm-v2 must handle
# correctly. Tight set picked to complete in ~60-90s wall-clock under
# UML overhead. Skips heavyweights (test_subprocess /
# test_concurrent_futures / test_threading would each take >60s under
# UML). Phase succeeds iff regrtest returns 0; explicit `|| (echo
# PYTEST_FAIL; exit 1)` ensures the phase wrapper sees non-zero on
# any failure (avoids the pipefail-loss bug from `cmd | tail; echo
# rc=$?` where echo's 0 masks pipeline failure).
[[init.phases]]
name = "pytest"
# 11-module curated subset (RESTORED 2026-05-21 post-SMP-T78 fix).
# kvm-v2's syscall dispatcher now releases migrate_disable() around
# handle_syscall, letting sched_setaffinity succeed under SMP without
# tripping the EBUSY guard in kernel/sched/core.c:3179.  test_os and
# test_posix are back in the curated set.
#
# test_signal.test_itimer_virtual remains an issue (SMP-T80, state-
# audit/29) but only triggers under ITIMER_VIRTUAL — the rest of
# test_signal passes.  We do NOT exclude test_signal because doing so
# loses coverage of the SIGCHLD/SIGINT/SIGALRM paths Series 7 needs to
# claim; if the itimer_virtual subtest still fails post-T78 fix, we
# revisit with Option B from memo 29 (clock_gettime delta credit).
cmd = "python3 -m test --timeout 60 -j 2 test_signal test_io test_mmap test_fcntl test_os test_select test_threadsignals test_posix test_fork1 test_random test_hashlib && echo PYTEST_OK || (echo PYTEST_FAIL; exit 1)"
expect = ""
timeout_secs = 240

[[init.phases]]
name = "report"
cmd = "echo REPRO_DONE rc=$?"
expect = ""
timeout_secs = 0

[host_resources]
# SMP-T78..T84 (memo 52: UML host resource controls).
# Soak defaults: predictable THP, expendable OOM bias.
# Hugepages and cpu_affinity opt-in — require host-side reservation.
# Cgroup limits opt-in — require writable cgroup hierarchy.
thp = "off"
oom_score_adj = 500
