schema_version = 1
volumes = []

[instance]
name = "soak-tier1-pylibs-{{BACKEND}}-w0"

[kernel]
path = "{{KERNEL}}"
backend = "{{BACKEND}}"

[runtime]
mem = "1536M"   # numpy + cryptography + requests need ~ 1 GB resident; +50% slack
ncpus = 4

[network]
mode = "none"

[env]
TMPDIR = "/tmp"
PYTHONHASHSEED = "0"

# Tier 1: host-installed Python C-extension smoke tests.
#
# Debian/Ubuntu apt packages do not ship upstream test submodules, so
# this template runs a deterministic smoke script instead of invoking
# package test suites directly.
#
# Same pipefail-loss discipline as cpython-soak: trailing
# `&& echo OK || (echo FAIL; exit 1)` (NOT `; echo rc=$?`).

[[init.phases]]
name = "smoke"
cmd = "/bin/true && echo SMOKE_OK"
expect = ""
timeout_secs = 0

# Initial surface: requests + cryptography. Numpy is exercised by Tier 2
# through an isolated virtualenv to avoid shared-site import ordering.
# Cryptography covers OpenSSL bindings and requests covers urllib3 /
# charset_normalizer URL parsing.
[[init.phases]]
name = "tier1-pylibs"
cmd = "cd /tmp && python3 {{SOAK_DIR}}/tier1-smoketest.py requests && python3 {{SOAK_DIR}}/tier1-smoketest.py cryptography && echo TIER1_OK || (echo TIER1_FAIL; exit 1)"
expect = ""
timeout_secs = 90

[[init.phases]]
name = "report"
cmd = "echo REPRO_DONE rc=$?"
expect = ""
timeout_secs = 0

[host_resources]
# Soak defaults: predictable THP, expendable OOM bias.
# Hugepages and cpu_affinity opt in; they require host-side reservation.
# Cgroup limits opt in; they require a writable cgroup hierarchy.
thp = "off"
oom_score_adj = 500
