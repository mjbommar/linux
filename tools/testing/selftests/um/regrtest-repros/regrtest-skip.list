# Curated skip list for `python -m test` under seccomp UML.
#
# Use as: python -m test -x $(grep -v '^#' regrtest-skip.list | tr '\n' ' ')
#
# Each entry below names a CPython regrtest module that fails on
# seccomp UML for a known, non-bug reason. The reproducer suite
# in this directory exercises the underlying surface in seconds;
# when a substrate fix lands, retire the relevant skip here.

# --- Class A: environmental (PID-1 init env, no real tty/pty/PATH) ---
# Reproducers: class-a-env/{terminal_size,openpty,tty_isatty,
#              controlling_tty,termios_get,ensurepip_check,
#              env_path_subprocess}.
test_cmd_line_script
test_compileall
test_ensurepip
test_openpty
test_shutil
test_termios
test_tty
test_venv

# --- Class B: process-model corners (UML stub-child lifecycle) ---
# Reproducers PASS; failures are Python-internal (asyncio transport
# state, multiprocessing.Pool start methods). Skip until we either
# find Python-level fixes or accept these as not-ready under seccomp.
# Several may resolve when worker ownership moves into the process
# model.
# Reproducers: class-b-process/*.
test.test_asyncio.test_events
test.test_asyncio.test_subprocess
test.test_concurrent_futures.test_as_completed
test.test_concurrent_futures.test_deadlock
test.test_concurrent_futures.test_init
test.test_concurrent_futures.test_process_pool
test.test_concurrent_futures.test_shutdown
test.test_concurrent_futures.test_wait
test_code_module
test_logging

# --- Class C: real surface gaps (mostly upstream changes) ---
# socket_udplite reproducer: UDP-Lite retired in 56520b398e5e.
# test_ioctl/test_os PTY subtests: same Class A env (no /dev/ptmx).
# test_struct/test_unicodedata: CPython quirks unrelated to UML.
test_ioctl
test_os
test_socket
test_struct
test_unicodedata

# --- Class D: structural (ITIMER_VIRTUAL accounting) ---
# Reproducer: class-d-structural/itimer_virtual.c.
# Hangs 180s+ in regrtest because the seccomp stub-child CPU-time
# mis-attribution makes SIGVTALRM never fire. Always pass `-x
# test_signal` to regrtest until the accounting model changes.
test_signal

# --- Other miscellaneous regrtest modules that observe environment
# rather than substrate. ---
test_sys
test_traceback
test_warnings
test_weakref
