-		      (unsigned long)&d->arch_data.gs_base);
+	if (!d->mm_single_threaded) {
+		stub_syscall2(__NR_arch_prctl, ARCH_GET_FS,
+			      (unsigned long)&d->arch_data.fs_base);
+		stub_syscall2(__NR_arch_prctl, ARCH_GET_GS,
