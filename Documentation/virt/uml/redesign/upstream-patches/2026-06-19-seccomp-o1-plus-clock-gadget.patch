diff --git a/arch/um/include/shared/skas/stub-data.h b/arch/um/include/shared/skas/stub-data.h
index d1d81f5e6af8..bfe9009776c7 100644
--- a/arch/um/include/shared/skas/stub-data.h
+++ b/arch/um/include/shared/skas/stub-data.h
@@ -68,6 +68,20 @@ struct stub_data {
 	/* seccomp architecture specific state restore */
 	struct stub_data_arch arch_data;
 
+	/*
+	 * O1: when the guest mm has a single user (single-threaded process,
+	 * mm_users==1), the stub may skip the per-trap FS/GS arch_prctl GET:
+	 * there is no other thread to clobber, and UML never rewrites an FS/GS
+	 * it believes unchanged, so a wrfsbase by the lone thread survives.
+	 * UML stamps this from handle_syscall(); a clone() that shares the mm
+	 * crosses and re-stamps it to 0 before the new thread runs.
+	 */
+	int mm_single_threaded;
+
+	/* Clock gadget offsets (guest_clock = host_clock - offset); see syscall.c. */
+	long long clock_mono_offset;
+	long long clock_real_offset;
+
 	/* Stack for signal handlers and stub syscall execution. */
 	unsigned char sigstack[UM_KERN_PAGE_SIZE] __aligned(UM_KERN_PAGE_SIZE);
 };
