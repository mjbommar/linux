# SPDX-License-Identifier: GPL-2.0
#
# profile: research-kmsan
#
# Research profile + KMSAN uninit-value detector. Sibling of
# `research` rather than a flag on it because KMSAN:
#
#   * Requires clang (LLVM=1). gcc cannot build this profile.
#   * Triples RSS for touched pages. 512M is the minimum comfortable
#     boot mem; 256M OOMs during stack_depot_init on some runners.
#   * Is mutually exclusive with KASAN in Kconfig. research-kmsan
#     DOES NOT select KASAN; `research` keeps KASAN.
#
# Use this profile when you want uninit-memory detection on a
# workload you can rebuild under clang. For out-of-bounds /
# use-after-free detection, stay on `research` (KASAN). For data
# races, `race` (KCSAN) — compatible with research-kmsan at the
# cost of further memory pressure.
#
# Backend: SECCOMP_ONLY. Same as research.

CONFIG_UM_BACKEND_SECCOMP_ONLY=y

# --- KMSAN ---------------------------------------------------------
CONFIG_KMSAN=y
# KMSAN_CHECK_PARAM_RETVAL: clang instruments parameter/return-value
# passing through the shadow. On by default via `default y if
# HAVE_KMSAN_PARAM_RETVAL`; name it explicitly so downstream
# profile edits don't silently drop it.
CONFIG_KMSAN_CHECK_PARAM_RETVAL=y

# FORTIFY routes explicit mem*/str* calls through the KMSAN-aware
# __msan_mem* helpers. Without it, UML's -fno-builtin build leaves
# ordinary memcpy()/memset()/memmove() calls on raw arch backends.
CONFIG_FORTIFY_SOURCE=y

# --- Explicitly disable KASAN (mutually exclusive with KMSAN) ------
# CONFIG_KASAN is not set

# --- Full debug surface (mirrors research) -------------------------
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_MAGIC_SYSRQ=y

# --- Modules + tracing (same as research) -------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_USER_EVENTS=y
