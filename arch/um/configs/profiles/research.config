# SPDX-License-Identifier: GPL-2.0
#
# profile: research
#
# "Every observability surface on; accept the cost." Intended for
# developers debugging guest-kernel issues or profiling a workload
# under observation. Slower and larger than normal profiles; nothing
# that can be turned on for diagnosis is turned off.
#
# Backend: SECCOMP_ONLY. Seccomp is both faster than ptrace and has
#          a richer introspection story. Research is the first place a
#          reviewer clones and runs.

CONFIG_UM_BACKEND_SECCOMP_ONLY=y

# --- Full debug surface --------------------------------------------
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BSD_PROCESS_ACCT=y

# --- Modules + their debug affordances -----------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- Tracing --------------------------------------------------------
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_USER_EVENTS=y
CONFIG_DYNAMIC_EVENTS=y
CONFIG_HIST_TRIGGERS=y
# Function tracer + dynamic ftrace. Compiler instruments every traced
# function with a 5-byte NOP via
# -fpatchable-function-entry=5,0; the per-function cost when
# tracing is off is about 0.3 ns. Function graph tracing is not
# enabled for UML because its return-address rewriting is not safe
# across UML's host-task stack switching.
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y

# Kprobes: int3-based
# probes at any kernel instruction, plus kretprobes via rethook
# (HAVE_RETHOOK auto-selects KRETPROBES + KRETPROBE_ON_RETHOOK).
CONFIG_KPROBES=y
# KUnit + the kprobes sanity suite; exercise the generic
# kunit tests at boot (~0.2 s overhead). KUnit itself is useful
# across this profile beyond just kprobes; enable generically
# here. Matches the "every surface on; accept the cost"
# research posture; regresses us loudly if anything with a KUnit test
# breaks.
CONFIG_KUNIT=y
CONFIG_KPROBES_SANITY_TEST=y

# Kprobes sample modules; build samples/kprobes/kprobe_example.ko
# and kretprobe_example.ko as loadable modules. The
# tools/testing/selftests/um/kprobes-stress/ selftest uses
# kretprobe_example.ko as the "probe-on-a-hot-
# function" workload; without SAMPLE_KRETPROBES the selftest
# emits SKIP. Enabling as modules (=m, not =y) matches the
# upstream samples/Kconfig requirement; kprobe examples are
# only valid as loadable modules because they rely on
# insmod/rmmod semantics to exercise arm/disarm paths.
CONFIG_SAMPLES=y
CONFIG_SAMPLE_KPROBES=m
CONFIG_SAMPLE_KRETPROBES=m

# --- BPF -----------------------------------------------------------
# Enable the syscall surface and JIT so bpftrace / perf / kprobe BPF
# programs are usable from the research profile out of the box.
# Unprivileged-BPF stays off per BPF_UNPRIV_DEFAULT_OFF; these are for
# root in a research UML.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# --- Coverage ------------------------------------------------------
# KCOV is intentionally disabled in `research`. The combination
# CONFIG_KCOV=y + CONFIG_FUNCTION_TRACER=y on UML-UP
# compounds under stop_machine (the batch ftrace patching path
# fires __sanitizer_cov_trace_pc in every internal helper call,
# amplified by KASAN shadow-memory checks, with no cond_resched
# because signals are blocked). Empirically: 5+ minutes hung on
# first `echo function > current_tracer`. Coverage-guided fuzzing
# is the domain of the `fuzz` and `fuzz-deep` profiles (which do
# not enable FUNCTION_TRACER); `research` keeps the tracer and
# sanitizers instead.
# CONFIG_KCOV is not set

# --- Sanitizers (KASAN + KFENCE on UML x86_64) ---------------------
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
# KASAN KUnit test suite as a loadable module. Not auto-run at
# boot (=m, not =y), so research boot stays clean of deliberate
# KASAN reports. The um/cve-repro selftest loads it on demand, parses
# the TAP results + BUG: KASAN: reports, and asserts the repro
# wall-clock stays under its runtime budget. Each test in
# lib/kasan_test.c is the minimal abstract repro of a
# CVE-class memory-safety bug (heap OOB read/write, use-after-
# free, stack OOB, double-free, etc.); detection under UML's
# research profile proves the full guest-kernel + KASAN +
# debug stack works.
CONFIG_KASAN_KUNIT_TEST=m

# Enlarge the printk ring buffer. The KASAN KUnit suite (via the
# cve-repro selftest) emits ~50 lines per BUG: KASAN: report plus
# per-test TAP lines; with ~10-20 tests the default 16 KiB
# (LOG_BUF_SHIFT=14) rolls early reports out before an init-side
# reader can consume them. 256 KiB (LOG_BUF_SHIFT=18) covers the
# M6 repro and leaves headroom for ftrace+kprobes diagnostic
# bursts during other research-profile workloads.
CONFIG_LOG_BUF_SHIFT=18
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_KFENCE=y
CONFIG_KFENCE_SAMPLE_INTERVAL=100
CONFIG_KFENCE_NUM_OBJECTS=255
CONFIG_KFENCE_KUNIT_TEST=m
# UBSAN_ALIGNMENT, _SHIFT etc stay toolchain-default

# --- Lockdep / RCU debug -------------------------------------------
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_RT_MUTEXES=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_ATOMIC_SLEEP=y

# --- Memory debug --------------------------------------------------
CONFIG_DEBUG_VM=y
CONFIG_DEBUG_PAGEALLOC=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_RCU_HEAD=y

# --- Optimization: favor debugability over size --------------------
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_CC_OPTIMIZE_FOR_DEBUGGING=y

# --- Time-travel available (opt, not forced) -----------------------
CONFIG_UML_TIME_TRAVEL_SUPPORT=y
