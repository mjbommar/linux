# SPDX-License-Identifier: GPL-2.0
#
# profile: sandbox
#
# Minimum trusted computing base. The intended operator is running
# hostile or mostly-untrusted workloads under UML and wants nothing
# extra in the kernel that could broaden an attack surface. No
# debugfs, no tracing, no modules, no magic SysRq.
#
# Backend: SECCOMP_ONLY (seccomp filter is part of the isolation
#          story; ptrace fallback weakens it).

CONFIG_UM_BACKEND_SECCOMP_ONLY=y

# --- NO debug surfaces ---------------------------------------------
# CONFIG_DEBUG_FS is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_IKCONFIG is not set
# CONFIG_IKCONFIG_PROC is not set
# CONFIG_BSD_PROCESS_ACCT is not set
# CONFIG_FTRACE is not set
# CONFIG_PROC_KCORE is not set

# --- NO modules ----------------------------------------------------
# CONFIG_MODULES is not set

# --- NO optional network (INET stays; no slip/ppp/tun/etc.) -------
# CONFIG_TUN is not set
# CONFIG_PPP is not set
# CONFIG_SLIP is not set
# CONFIG_DUMMY is not set
# CONFIG_BINFMT_MISC is not set

# --- Size tuning ---------------------------------------------------
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
