# SPDX-License-Identifier: GPL-2.0
#
# profile: prod-fast
#
# Minimum-overhead UML for workloads that do not need a runtime
# observability surface. The smallest binary and fastest syscall path
# the current codebase offers.
#
# Backend: DYNAMIC (backend=auto at boot); will prefer seccomp when
#          the host supports it; falls back to ptrace otherwise. KVM
#          is selected automatically once the backend is available.
#
# Observability: none. No /sys/kernel/debug, no /sys/kernel/tracing.
#                The static-key gates are compiled in (they're obj-y in
#                arch/um/kernel/) but they stay off for the life of
#                the boot because nothing can flip them without
#                debugfs.

CONFIG_UM_BACKEND_DYNAMIC=y

# --- Debug/observability surfaces: off ------------------------------
# CONFIG_DEBUG_FS is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_IKCONFIG is not set
# CONFIG_IKCONFIG_PROC is not set
# CONFIG_BSD_PROCESS_ACCT is not set
# CONFIG_FTRACE is not set

# --- Modules: off for minimum binary -------------------------------
# CONFIG_MODULES is not set

# --- Size tuning ---------------------------------------------------
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_DEBUG_KERNEL=y
# Debug kernel stays on so WARN_ON() is available; DEBUG_* sub-
# options that add runtime cost are left off.
