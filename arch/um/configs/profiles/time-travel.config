# SPDX-License-Identifier: GPL-2.0
#
# profile: time-travel
#
# Deterministic clock and scheduling for repeatable test runs and
# simulation workloads. UP only.
#
# Backend: SECCOMP_ONLY for speed and clean time-travel integration.
# Time travel: forced on via CONFIG_UML_TIME_TRAVEL_SUPPORT.

CONFIG_UM_BACKEND_SECCOMP_ONLY=y

# --- Time-travel machinery -----------------------------------------
CONFIG_UML_TIME_TRAVEL_SUPPORT=y

# --- UP only (time-travel is defined for single-CPU guests) --------
# CONFIG_SMP is not set

# --- Debug affordances (developers using time-travel debug heavily)
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
CONFIG_DEBUG_KERNEL=y
CONFIG_MAGIC_SYSRQ=y

# --- Tracing (ftrace + user_events for span correlation) -----------
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_USER_EVENTS=y
CONFIG_DYNAMIC_EVENTS=y

# --- Sanitizers (time-travel + KASAN catches deterministic bugs) --
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y

# --- Modules -------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
