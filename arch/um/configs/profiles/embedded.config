# SPDX-License-Identifier: GPL-2.0
#
# profile: embedded
#
# For hosts without seccomp-filter support (CI environments,
# shared-kernel containers without CAP_SYS_ADMIN) or for legacy
# systems. Uses the ptrace backend exclusively. Minimal Kconfig
# otherwise.
#
# Backend: PTRACE_ONLY. Slower than seccomp but works on any
#          Linux host with ptrace (essentially all of them).

CONFIG_UM_BACKEND_PTRACE_ONLY=y

# --- No sanitizers, no tracing, minimal debug ----------------------
# CONFIG_DEBUG_FS is not set
# CONFIG_FTRACE is not set
# CONFIG_MAGIC_SYSRQ is not set

# --- mconsole kept: diagnostics on a host where debugfs may be ----
# --- unavailable but the developer still needs a control channel --
CONFIG_MCONSOLE=y

# --- Modules kept (embedded users often load custom drivers) ------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- Size tuning ---------------------------------------------------
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_DEBUG_KERNEL=y
