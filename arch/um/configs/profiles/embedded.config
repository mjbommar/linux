# SPDX-License-Identifier: GPL-2.0
#
# profile: embedded
#
# Size-tuned profile for embedded / sandbox use. Minimal Kconfig:
# no debugfs, no ftrace, no magic sysrq.
#
# The ptrace backend has been removed. Hosts genuinely without
# CONFIG_SECCOMP_FILTER should pin to UML v6.16 or earlier.
#
# Backend: SECCOMP_ONLY. Single-backend inline; smallest binary.

CONFIG_UM_BACKEND_SECCOMP_ONLY=y

# --- No sanitizers, no tracing, minimal debug ----------------------
# CONFIG_DEBUG_FS is not set
# CONFIG_FTRACE is not set
# CONFIG_MAGIC_SYSRQ is not set

# --- mconsole kept: diagnostics on a host where debugfs may be ----
# --- unavailable but the developer still needs a control channel --
CONFIG_MCONSOLE=y

# --- Modules kept (embedded users often load custom drivers) ------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- Size tuning ---------------------------------------------------
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_DEBUG_KERNEL=y
