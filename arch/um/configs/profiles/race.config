# SPDX-License-Identifier: GPL-2.0
#
# profile: race
#
# Focused on data-race detection via KCSAN. Separate from
# fuzz-deep because upstream Linux mutually excludes KASAN and
# KCSAN (lib/Kconfig.kcsan: `depends on DEBUG_KERNEL && !KASAN`),
# so "fuzz-deep with both" isn't a thing you can compile. Ship
# each detector in its own profile: fuzz-deep keeps KASAN, race
# has KCSAN.
#
# Backend: SECCOMP_ONLY (race workloads hammer syscalls).

CONFIG_UM_BACKEND_SECCOMP_ONLY=y

# --- SMP required for KCSAN to have meaningful work ---------------
CONFIG_SMP=y

# --- KCSAN (compile-time TSAN watchpoints + delays) ---------------
CONFIG_KCSAN=y
# KCSAN starts OFF at boot for predictable boot time. Flip on via
#   echo on >/sys/kernel/debug/kcsan
# or set CONFIG_KCSAN_EARLY_ENABLE=y in a custom build fragment.
# Boot with `ncpus=2` (or more) so kcsan has concurrent CPUs to
# detect races across.
# CONFIG_KCSAN_EARLY_ENABLE is not set
# Reproduce KCSAN's selftest at boot (3 quick tests, validates
# instrumentation; ~no boot-time cost).
CONFIG_KCSAN_SELFTEST=y
# The full upstream KUnit suite (CONFIG_KCSAN_KUNIT_TEST) is NOT
# enabled here — its 30 tests each spawn racing threads and run
# for many seconds, which would slow boot to a crawl. Users who
# want it: build a custom fragment with KCSAN_KUNIT_TEST=y +
# KUNIT=y, or run the tests via tools/testing/kunit/kunit.py.

# --- Lockdep (complementary race / deadlock detection) -----------
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_RT_MUTEXES=y

# --- debugfs for KCSAN control + stats ----------------------------
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
CONFIG_DEBUG_KERNEL=y

# --- Explicitly disable KASAN (mutually exclusive with KCSAN) ----
# CONFIG_KASAN is not set

# --- Modules stay on (many race-prone subsystems are modules) ----
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- Tracing surface for correlating reported races --------------
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_USER_EVENTS=y
