# SPDX-License-Identifier: GPL-2.0
#
# profile: fuzz
#
# Optimized for syzkaller-style coverage-guided fuzzing. KCOV on,
# KASAN on, everything else minimal. Intended for a fuzz loop that
# boots, runs a workload, captures coverage, and reboots many times
# per second.
#
# Backend: SECCOMP_ONLY. Seccomp has the fastest boot under a fuzz
#          harness and better behavior under snapshot/restore.

CONFIG_UM_BACKEND_SECCOMP_ONLY=y

# --- debugfs needed for KCOV ---------------------------------------
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y

# --- Coverage ------------------------------------------------------
CONFIG_KCOV=y
CONFIG_KCOV_ENABLE_COMPARISONS=y

# --- Sanitizer (catches the bugs we're fuzzing for) ----------------
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
# KASAN_INLINE is the fast form; stays at toolchain default

# --- Tracing infra gating USER_EVENTS ------------------------------
# USER_EVENTS lives inside `if FTRACE` in kernel/trace/Kconfig and
# selects TRACING + DYNAMIC_EVENTS. We enable FTRACE just enough to
# unlock USER_EVENTS; no other tracers turn on.
CONFIG_FTRACE=y
CONFIG_USER_EVENTS=y

# --- Forkserver / snapshot seam (workstream C-09) ------------------
# Enables the AFL-compatible forkserver protocol on fds 198/199
# and /sys/kernel/um/state_version. v1 ceiling is documented in
# Documentation/virt/uml/snapshot.rst; sustained fuzz on blocking
# guest syscalls is still gated on the v2 freezer-cgroup design
# per decisions-log D41/D42.
CONFIG_UM_FUZZ_HOOKS=y
CONFIG_UM_SNAPSHOT_FORKSERVER=y

# --- Modules off (fuzz corpus is kernel-internal; less surface) ----
# CONFIG_MODULES is not set

# --- Trim non-essentials -------------------------------------------
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_BSD_PROCESS_ACCT is not set

CONFIG_DEBUG_KERNEL=y
