# SPDX-License-Identifier: GPL-2.0
#
# profile: fuzz-deep
#
# Fuzz + KCSAN + record/replay gate. Heavier than plain fuzz; meant
# for targeted sessions after fuzz turns up a candidate bug and the
# developer wants data-race + deterministic-replay context.
#
# Backend: SECCOMP_ONLY (same as fuzz).
#
# KCSAN is listed in this profile's long-term plan but the UML port
# (workstream C-03) has not landed yet; once it does, add
# CONFIG_KCSAN=y here. For today, fuzz-deep == fuzz + KASAN-INLINE +
# record-replay gate default-on. The absence of KCSAN is recorded
# in notes/profile-matrix.md.

CONFIG_UM_BACKEND_SECCOMP_ONLY=y

# --- Everything fuzz has ------------------------------------------
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
CONFIG_KCOV=y
CONFIG_KCOV_ENABLE_COMPARISONS=y
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
# --- Tracing gate for USER_EVENTS (see fuzz.config for rationale) --
CONFIG_FTRACE=y
CONFIG_USER_EVENTS=y

# --- Additional: KASAN_INLINE for tighter bug catch ----------------
CONFIG_KASAN_INLINE=y

# --- KFENCE (sampling heap-corruption detector, C-02) --------------
CONFIG_KFENCE=y
CONFIG_KFENCE_SAMPLE_INTERVAL=100
CONFIG_KFENCE_NUM_OBJECTS=255

# --- Lockdep (catches the races KCSAN would catch, partially) -----
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y

# --- Modules off ---------------------------------------------------
# CONFIG_MODULES is not set

# --- Trim ----------------------------------------------------------
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_BSD_PROCESS_ACCT is not set

CONFIG_DEBUG_KERNEL=y

# KCSAN: add CONFIG_KCSAN=y when workstream C-03 lands the port.
# KFENCE: enabled above via C-02 port.
