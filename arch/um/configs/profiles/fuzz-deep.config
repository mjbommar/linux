# SPDX-License-Identifier: GPL-2.0
#
# profile: fuzz-deep
#
# Fuzz + deeper sanitizers. Heavier than plain fuzz; meant
# for targeted sessions after fuzz turns up a candidate bug and the
# developer wants denser diagnostics.
#
# Backend: SECCOMP_ONLY (same as fuzz).
#
# fuzz-deep == fuzz + KASAN-INLINE + KFENCE + lockdep.

CONFIG_UM_BACKEND_SECCOMP_ONLY=y

# --- Everything fuzz has ------------------------------------------
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
CONFIG_KCOV=y
CONFIG_KCOV_ENABLE_COMPARISONS=y
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
# --- Tracing gate for USER_EVENTS (see fuzz.config for rationale) --
CONFIG_FTRACE=y
CONFIG_USER_EVENTS=y

# --- Additional: KASAN_INLINE for tighter bug catch ----------------
CONFIG_KASAN_INLINE=y

# --- KFENCE (sampling heap-corruption detector) --------------------
CONFIG_KFENCE=y
CONFIG_KFENCE_SAMPLE_INTERVAL=100
CONFIG_KFENCE_NUM_OBJECTS=255

# --- Lockdep (catches the races KCSAN would catch, partially) -----
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y

# --- Forkserver / snapshot seam -----------------------------------
# Enables the AFL-compatible forkserver protocol on fds 198/199
# and /sys/kernel/um/state_version. v1 ceiling (short non-blocking
# guest programs only) documented in Documentation/virt/uml/
# snapshot.rst; sustained fuzz on blocking guest syscalls is gated on
# the v2 freezer-cgroup design.
CONFIG_UM_FUZZ_HOOKS=y
CONFIG_UM_SNAPSHOT_FORKSERVER=y

# --- Modules off ---------------------------------------------------
# CONFIG_MODULES is not set

# --- Trim ----------------------------------------------------------
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_BSD_PROCESS_ACCT is not set

CONFIG_DEBUG_KERNEL=y

# KCSAN: add CONFIG_KCSAN=y once the UML port lands.
# KFENCE: enabled above.
