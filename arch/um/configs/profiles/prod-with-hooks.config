# SPDX-License-Identifier: GPL-2.0
#
# profile: prod-with-hooks
#
# Same low-overhead posture as prod-fast PLUS the ability to
# flip static-key gates at runtime via /sys/kernel/debug/um/hooks/*.
# All gates ship compiled-in but off; users enable narrow observability
# on demand (syscall trace for 10 seconds during an
# incident, for example) then flips back off.
#
# Backend: DYNAMIC (prefers seccomp; KVM once available).
# Observability: runtime-flippable via debugfs, none on by default.

CONFIG_UM_BACKEND_DYNAMIC=y

# --- debugfs ON so gates can be toggled -----------------------------
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y

# --- Basic debugging affordances -----------------------------------
CONFIG_DEBUG_KERNEL=y
CONFIG_MAGIC_SYSRQ=y

# --- Modules: on (device modules may be loaded at runtime) ---------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- Size tuning ----------------------------------------------------
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# --- Tracing surface ------------------------------------------------
# FTRACE=y opens the Kconfig menu; FTRACE_SYSCALLS pulls in the
# GENERIC_TRACER machinery that gives us /sys/kernel/tracing with
# available_tracers, events/, etc. Per-syscall tracepoint registration
# adds a few ms to boot and a few KB to memory; acceptable for a
# profile whose purpose is runtime observability.
# Runtime consumers stay off by default via tracefs knobs.
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
