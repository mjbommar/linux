menu "UML-specific options"

config UML
	bool
	default y
	select ARCH_DISABLE_KASAN_INLINE if STATIC_LINK
	select ARCH_NEEDS_DEFER_KASAN if STATIC_LINK
	select ARCH_WANTS_DYNAMIC_TASK_STRUCT
	select ARCH_HAS_CACHE_LINE_SIZE
	select ARCH_HAS_CPU_FINALIZE_INIT
	select ARCH_HAS_FORTIFY_SOURCE
	select ARCH_HAS_GCOV_PROFILE_ALL
	select ARCH_HAS_KCOV
	select ARCH_HAS_STRNCPY_FROM_USER
	select ARCH_HAS_STRNLEN_USER
	select ARCH_HAS_STRICT_KERNEL_RWX
	select HAVE_ARCH_AUDITSYSCALL
	select HAVE_ARCH_KASAN if X86_64
	select HAVE_ARCH_KASAN_VMALLOC if HAVE_ARCH_KASAN
	select HAVE_ARCH_KCSAN if X86_64
	select HAVE_ARCH_KFENCE if X86_64
	# KMSAN on UML is currently broken by design (Finding #2,
	# 2026-04-23 review; see
	# Documentation/virt/uml/redesign/04-risks/decisions-log.md
	# entry D58). The dedicated-host-mmap scheme in
	# arch/um/include/asm/kmsan.h wants two 128 TiB slabs but
	# arch/um/Kconfig's KMSAN_SHADOW_OFFSET / KMSAN_ORIGIN_OFFSET
	# place them 16 TiB apart, so the shadow range overflows
	# into origin (and together would exceed the canonical lower
	# half). Runtime smoke fails at early shadow mmap. Gate on
	# BROKEN until a workable design lands (either VMALLOC
	# quarter-split mirroring x86, or a UML-side task_size cap
	# under KMSAN). Remove this BROKEN gate when the redesign
	# lands.
	select HAVE_ARCH_KMSAN if X86_64 && BROKEN
	select HAVE_ARCH_KMSAN_VMALLOC if HAVE_ARCH_KMSAN
	select HAVE_ARCH_SECCOMP_FILTER
	select HAVE_ASM_MODVERSIONS
	select HAVE_UID16
	select HAVE_DEBUG_KMEMLEAK
	select HAVE_DEBUG_BUGVERBOSE
	select HAVE_PAGE_SIZE_4KB
	select NO_DMA if !UML_DMA_EMULATION
	select OF_EARLY_FLATTREE if OF
	select GENERIC_IRQ_SHOW
	select GENERIC_CPU_DEVICES
	select GENERIC_SMP_IDLE_THREAD
	select HAVE_GCC_PLUGINS
	select ARCH_SUPPORTS_LTO_CLANG
	select ARCH_SUPPORTS_LTO_CLANG_THIN
	select TRACE_IRQFLAGS_SUPPORT
	select TTY # Needed for line.c
	select HAVE_ARCH_VMAP_STACK
	select HAVE_RUST
	select ARCH_HAS_UBSAN
	select HAVE_ARCH_TRACEHOOK
	select HAVE_SYSCALL_TRACEPOINTS
	select HAVE_FUNCTION_TRACER if X86_64
	select HAVE_DYNAMIC_FTRACE if HAVE_FUNCTION_TRACER
	select FTRACE_MCOUNT_USE_PATCHABLE_FUNCTION_ENTRY \
		if DYNAMIC_FTRACE
	# HAVE_FUNCTION_GRAPH_TRACER depends on CC_FLAGS_FTRACE being
	# stripped from arch/um's signal-dispatch + longjmp-entry TUs
	# (see arch/um/os-Linux/Makefile + arch/um/kernel/Makefile
	# CFLAGS_REMOVE_<file>.o lines, landed as C-04 commit 3a) and
	# on the notrace annotations in arch/um/kernel/signal.c's
	# arch_local_irq_* helpers. See Documentation/virt/uml/
	# redesign/04-risks/decisions-log.md D34 for the full
	# background.
	select HAVE_FUNCTION_GRAPH_TRACER if HAVE_FUNCTION_TRACER
	select HAVE_KPROBES if X86_64
	# HAVE_RETHOOK auto-selects RETHOOK and turns on KRETPROBE_ON_RETHOOK,
	# which is how modern x86_64 supplies KRETPROBES (see D33). No need
	# to also select HAVE_KRETPROBES — arch/Kconfig's KRETPROBES depends
	# on (HAVE_KRETPROBES || HAVE_RETHOOK).
	select HAVE_RETHOOK if X86_64
	# BPF JIT (workstream C-06 v1 per D43 fifth-view). UML
	# consumes arch/x86/net/bpf_jit_comp.c with a handful of
	# UML-local shim headers (asm/vsyscall.h, cpufeature.h's
	# DISABLED_MASK_BIT_SET stub, arch/um/kernel/x86_nops.c)
	# plus a small CONFIG_UM branch in bpf_jit_comp.c's
	# reg2pt_regs[] table. Bare-metal x86 builds are
	# bit-identical past the three upstream-bound hygiene
	# commits (e2b686c96, 5b95b1bb3, this series). See
	# Documentation/virt/uml/redesign/02-workstreams/
	# C-profiles-and-gaps/06-port-bpf-jit.md.
	select HAVE_EBPF_JIT if X86_64
	select THREAD_INFO_IN_TASK
	select SPARSE_IRQ
	select MMU_GATHER_RCU_TABLE_FREE

